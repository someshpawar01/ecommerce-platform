
# IntelliJ IDEA
.idea/
*.iml

# VS Code - ignore personal settings by default
.vscode/*
**/.vscode/*

# Allow shared frontend workspace configuration
!frontend/.vscode/
!frontend/.vscode/settings.json
!frontend/.vscode/extensions.json

# Java / Maven
**/target/
*.class
*.log

# Node.js / React
**/node_modules/
**/dist/
**/coverage/
*.tsbuildinfo

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.*.example

# Local Spring configuration
**/application-local.yml
**/application-local.yaml
**/application-local.properties

# Track the safe, password-free backend local configuration
!backend/src/main/resources/application-local.yaml

# Uploaded files
storage/uploads/
**/uploads/

# Operating system
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak

# Additional IntelliJ IDEA files
*.iws
*.ipr

# Eclipse / Spring Tool Suite
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/

# NetBeans
**/nbproject/private/
**/nbbuild/
**/nbdist/
**/.nb-gradle/

# Additional build output
**/build/
